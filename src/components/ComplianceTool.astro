---
const features = [
  {
    title: 'CMMC Level 1 Self-Assessment',
    description: 'Guided assessment against all 15 FAR 52.204-21 requirements and 58 NIST SP 800-171A objectives with binary MET/NOT MET scoring.',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Evidence Management',
    description: 'Upload and organize supporting documentation with encrypted S3 storage, typed notes, and 6-year retention enforcement for 32 CFR Part 170 compliance.',
    icon: 'M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
  {
    title: 'SPRS Score & Reporting',
    description: 'Automatic SPRS score calculation with PDF report generation, affirmation workflow, and digital attestation for submission readiness.',
    icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
  {
    title: 'Defense-Grade Security',
    description: 'MFA with TOTP, AES-256-GCM encryption at rest, role-based access control, tamper-evident audit trails, and account lockout protection.',
    icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
  },
];
---

<section id="products" class="py-24 md:py-32 px-6 bg-bg-surface">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16 reveal">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-gold mb-4">Live Product</span>
      <h2 class="font-display font-bold text-4xl md:text-5xl gradient-headline inline-block mb-4">
        CMMC Compliance Platform
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto">
        A self-assessment tool for Defense Industrial Base contractors to evaluate, document, and attest to CMMC Level 1 compliance under 32 CFR Part 170.
      </p>
    </div>

    <div class="glass-card p-8 md:p-12 mb-12 reveal">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 items-center">
        <div class="lg:col-span-3 space-y-6">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-xl bg-gold/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="font-display font-bold text-2xl text-text-primary">What It Does</h3>
          </div>
          <p class="text-text-secondary leading-relaxed">
            The CMMC Compliance Platform guides organizations through the complete CMMC Level 1 self-assessment lifecycle. It maps every control requirement from FAR 52.204-21 to its corresponding NIST SP 800-171A assessment objectives, provides a structured workflow for documenting compliance status and uploading evidence, and generates submission-ready SPRS scores with PDF reports.
          </p>
          <p class="text-text-secondary leading-relaxed">
            Built for contractors handling Federal Contract Information (FCI), the platform enforces 6-year evidence retention, maintains tamper-evident audit trails, and supports multi-user organizations with role-based access control -- meeting the security standards it helps you assess.
          </p>
          <div class="flex flex-wrap gap-3 pt-2">
            <a href="https://compliance.kblabs.us" target="_blank" rel="noopener" class="btn-primary text-sm">
              Launch Platform
              <svg class="w-4 h-4 inline-block ml-1 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a href="#contact" class="btn-secondary text-sm">Request a Demo</a>
          </div>
        </div>

        <div class="lg:col-span-2">
          <div class="space-y-3">
            <div class="glass-card p-4 flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-green-500/10 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <p class="text-text-primary text-sm font-medium">15 FAR 52.204-21 Requirements</p>
                <p class="text-text-muted text-xs">Full coverage of basic safeguarding controls</p>
              </div>
            </div>
            <div class="glass-card p-4 flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-green-500/10 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <p class="text-text-primary text-sm font-medium">58 NIST SP 800-171A Objectives</p>
                <p class="text-text-muted text-xs">Granular assessment at the objective level</p>
              </div>
            </div>
            <div class="glass-card p-4 flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-green-500/10 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <p class="text-text-primary text-sm font-medium">SPRS Score Generation</p>
                <p class="text-text-muted text-xs">Automated scoring with PDF report export</p>
              </div>
            </div>
            <div class="glass-card p-4 flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-green-500/10 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <p class="text-text-primary text-sm font-medium">6-Year Evidence Retention</p>
                <p class="text-text-muted text-xs">Encrypted S3 storage with compliance-mode lock</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature, i) => (
        <div class="glass-card p-6 reveal" style={`transition-delay: ${i * 100}ms;`}>
          <div class="w-10 h-10 rounded-xl bg-gold/10 flex items-center justify-center mb-4 group-hover:bg-gold/20 transition-colors">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={feature.icon} />
            </svg>
          </div>
          <h3 class="font-display font-semibold text-sm text-text-primary mb-2">
            {feature.title}
          </h3>
          <p class="text-text-secondary text-xs leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-12 text-center reveal">
      <p class="text-text-secondary text-sm">
        Built with Next.js, PostgreSQL, and AWS. Secured with MFA, AES-256-GCM encryption, and role-based access control.
      </p>
    </div>
  </div>
</section>
